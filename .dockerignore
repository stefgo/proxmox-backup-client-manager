# Keep the build context small. Everything the builder stages need is copied
# explicitly (manifests, .npmrc, shared/, client/, server/, scripts/) - anything
# generated or local-only just slows down the context upload and busts the cache.

# Dependencies - reinstalled inside the image via `npm ci`
**/node_modules

# Build artifacts - regenerated by the builder stage
shared/dist
client/dist
server/backend/dist
server/dist
server/frontend/dist

# Local runtime state (SQLite DBs, generated config) - must never leak into an image
**/data
**/config.yaml
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# VCS, CI and tooling
.git
.gitignore
.github
.vscode
.idea
.claude

# Docs and compose files - not part of any image
doc
*.md
compose*.yaml
compose*.yml

# Logs and OS noise
**/*.log
npm-debug.log*
.DS_Store
