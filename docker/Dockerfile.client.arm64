# Builder Stage
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy manifest files and registry config
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/
COPY shared/package.json shared/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

# Install all dependencies (including dev for building, with GitHub Packages auth)
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci

# Copy source code
COPY shared ./shared
COPY client ./client
COPY scripts ./scripts

# Build shared and client
RUN npm run build -w shared
RUN npm run build -w client

# Generate Version file for production
ARG APP_VERSION=unknown
RUN APP_VERSION=${APP_VERSION} bash ./scripts/generate-version.sh ./client/dist/VERSION

# Prune dev dependencies.
# `npm prune` works purely on the existing node_modules tree - no registry round
# trip and no rebuild of native modules (better-sqlite3), unlike `npm ci --omit=dev`.
RUN npm prune --omit=dev

# Runner Stage
FROM debian:trixie-slim AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

# Install dependencies (Node.js + Proxmox Backup Client + libsqlite3)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    gnupg \
    curl \
    lsb-release \
    libsqlite3-0 \
    && \
    # Node.js Setup
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    nodejs && \
    # Install wofferl's proxmox-backup-client
    wget https://github.com/wofferl/proxmox-backup-arm64/releases/download/4.1.4-1/proxmox-backup-client_4.1.4-1_arm64.deb && \
    apt-get install -y ./proxmox-backup-client_4.1.4-1_arm64.deb && \
    rm proxmox-backup-client_4.1.4-1_arm64.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy artifacts from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared/package.json ./shared/
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/client/package.json ./client/
COPY --from=builder /app/client/dist ./client/dist

# Switch to client directory so paths align with dev environment (config.json resolution)
WORKDIR /app/client

# Liveness probe. Node is installed here anyway and Node 22 has fetch as a global,
# so the check needs neither curl nor wget. The port follows the agent's own config
# (PBCM_CLIENT_PORT, default 3001 -- see client/src/core/Config.ts).
#
# DISABLE_WEB_UI=true exits 0 straight away: with the web UI switched off there is no
# HTTP server by design, and reporting that as unhealthy would be a false alarm.
#
# Deliberately unrelated to the server connection. The agent runs its jobs from its own
# SQLite copy whether or not the server is reachable, so a lost connection is not a
# reason to call it unhealthy. Note also that Docker does not restart an unhealthy
# container -- restart policies react to a process exiting, not to health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e 'if (process.env.DISABLE_WEB_UI === "true") process.exit(0); const p = process.env.PBCM_CLIENT_PORT || 3001; fetch("http://127.0.0.1:" + p + "/api/health").then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "dist/index.js"]
