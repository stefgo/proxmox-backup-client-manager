# Builder Stage
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy manifest files and registry config
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/
COPY shared/package.json shared/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

# Install all dependencies (including dev for building, with GitHub Packages auth)
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci

# Copy source code
COPY shared ./shared
COPY client ./client
COPY scripts ./scripts

# Build shared and client
RUN npm run build -w shared
RUN npm run build -w client

# Generate Version file for production
ARG APP_VERSION=unknown
RUN APP_VERSION=${APP_VERSION} bash ./scripts/generate-version.sh ./client/dist/VERSION

# Prune dev dependencies.
# `npm prune` works purely on the existing node_modules tree - no registry round
# trip and no rebuild of native modules, unlike `npm ci --omit=dev`.
RUN npm prune --omit=dev

# wofferl's proxmox-backup-client, fetched in a stage of its own: ADD needs neither wget nor
# curl in the image, and mounting the package from here instead of copying it keeps it out
# of the runner's layers.
FROM scratch AS pbs-client
ADD https://github.com/wofferl/proxmox-backup-arm64/releases/download/4.1.4-1/proxmox-backup-client_4.1.4-1_arm64.deb \
    /proxmox-backup-client.deb

# Runner Stage
# Node comes with the base image; what is installed on top is proxmox-backup-client and the
# CA certificates it checks a PBS against. The agent runs no other program of its own -- the
# tunnel of an outbound client is a TCP connection, not an ssh process. The Debian release
# is the one the package above is built for.
FROM node:22-trixie-slim AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
# Tells the agent it runs in this image, which is the only place /api/health is served --
# see getWebRoutes() in client/src/web/server.ts.
ENV PBCM_CONTAINER=true

# Install dependencies (Proxmox Backup Client)
RUN --mount=type=bind,from=pbs-client,source=/proxmox-backup-client.deb,target=/tmp/proxmox-backup-client.deb \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    /tmp/proxmox-backup-client.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy artifacts from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared/package.json ./shared/
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/client/package.json ./client/
COPY --from=builder /app/client/dist ./client/dist

# Switch to client directory so paths align with dev environment (config.json resolution)
WORKDIR /app/client

# Liveness probe. Node is installed here anyway, so the check needs neither curl nor wget.
#
# The address comes from /tmp/pbcm-health.json, which the agent writes after listen() with
# the port and scheme it actually serves -- so a listenPort or `tls` block set only in
# config.yaml is followed as well as PBCM_CLIENT_PORT (see HEALTH_FILE in
# client/src/web/server.ts). Without that file -- during start-up, or in an image from
# before it existed -- the probe asks PBCM_CLIENT_PORT (default 3001), plain HTTP first;
# only a failed connection falls through to HTTPS, so a 503 over HTTP stays a 503.
#
# The certificate is not verified: the request goes to 127.0.0.1 inside the container,
# where no name in it would match, and sends nothing that needs protecting.
#
# The route exists in this image whatever config.yaml says, and answers loopback only.
# With both pages disabled and no outbound mode the web server still starts for it, bound
# to 127.0.0.1 -- so the probe always asks something that is there.
#
# Deliberately unrelated to the server connection. The agent runs its jobs from its own
# data files whether or not the server is reachable, so a lost connection is not a
# reason to call it unhealthy. Note also that Docker does not restart an unhealthy
# container -- restart policies react to a process exiting, not to health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e 'const get = (u) => new Promise((done) => require(u.split(":")[0]).get(u, { rejectUnauthorized: false }, (r) => done(r.statusCode)).on("error", () => done(0))); let f; try { f = JSON.parse(require("fs").readFileSync("/tmp/pbcm-health.json", "utf8")).url; } catch {} const u = "://127.0.0.1:" + (process.env.PBCM_CLIENT_PORT || 3001) + "/api/health"; (f ? get(f) : get("http" + u).then((s) => s || get("https" + u))).then((s) => process.exit(s === 200 ? 0 : 1))'

CMD ["node", "dist/index.js"]
