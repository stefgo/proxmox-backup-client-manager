# Builder Stage
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy manifest files and registry config
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/
COPY shared/package.json shared/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

# Install all dependencies (with GitHub Packages auth).
# package-lock.json carries every platform variant of the optional rollup binary
# with its os/cpu metadata, so npm ci picks the right one by itself -- both here
# and on arm64. The explicit install this used to carry was a leftover from an
# older lockfile that had them pruned.
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci

# Copy source code
COPY shared ./shared
COPY server ./server
COPY scripts ./scripts

# Build
ARG APP_VERSION=unknown
RUN npm run build -w shared
RUN npm run build -w server/backend
# Pass the version to the frontend build. Nothing on the backend reads a
# VERSION file -- only the client agent reports its version to the server.
RUN VITE_APP_VERSION=${APP_VERSION} VITE_USE_LOCAL_UI=false npm run build -w server/frontend

# Prune dev dependencies.
# `npm prune` works purely on the existing node_modules tree - no registry round
# trip and no rebuild of native modules (better-sqlite3), unlike `npm ci --omit=dev`.
RUN npm prune --omit=dev

# Runner Stage
FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production

WORKDIR /app

# Copy artifacts from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared/package.json ./shared/
COPY --from=builder /app/shared/dist ./shared/dist
# Copy Backend
COPY --from=builder /app/server/backend/package.json ./server/backend/
COPY --from=builder /app/server/backend/dist ./server/backend/dist
# Copy Frontend (Static Files)
COPY --from=builder /app/server/dist/public ./server/dist/public

# Switch to backend directory
WORKDIR /app/server/backend

# Liveness probe. This image carries neither curl nor wget, but it does carry Node,
# and Node 22 has fetch as a global -- so the check needs no extra package.
# Port 3000 is hardcoded in index.ts.
#
# start-period covers the startup work before listen(): migrations, OIDC discovery
# and the initial admin account.
#
# Note that Docker does NOT restart an unhealthy container -- restart policies react
# to a process exiting, not to health. This makes the state visible in `docker ps`,
# lets compose use `depends_on: condition: service_healthy`, and gives monitoring
# something to read.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e 'fetch("http://127.0.0.1:3000/api/health").then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "dist/index.js"]
