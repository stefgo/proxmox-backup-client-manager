{
    "name": "pbcm-client",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "prebuild": "rimraf dist",
        "start": "tsx src/index.ts",
        "dev": "tsx watch --conditions development src/index.ts",
        "build": "tsc -p tsconfig.build.json && cp -r src/web/public dist/web/ && bash ../scripts/generate-version.sh dist/VERSION",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/static": "^10.1.6",
        "@fastify/websocket": "^11.3.4",
        "@pbcm/shared": "*",
        "fastify": "^5.12.5",
        "ws": "^8.22.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^25.9.9",
        "@types/ws": "^8.18.2",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
